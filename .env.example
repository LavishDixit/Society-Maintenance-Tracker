# ---------------------------------------------------------------------------
# Core Django settings
# ---------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database
# Leave unset to use local SQLite. In production, set to your Postgres URL,
# e.g. postgres://user:password@host:5432/dbname
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Business logic
# Number of days an open/in-progress complaint can sit before it is
# flagged as overdue on the admin dashboard.
# ---------------------------------------------------------------------------
OVERDUE_THRESHOLD_DAYS=5

# ---------------------------------------------------------------------------
# Photo uploads (Cloudinary)
# Set USE_CLOUDINARY=True in production since hosts like Render/Railway do
# not persist local disk storage across deploys.
# Get free credentials at https://cloudinary.com
# ---------------------------------------------------------------------------
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (SendGrid free tier via SMTP relay)
# Leave EMAIL_BACKEND as the console backend for local development -
# emails will just print to your terminal instead of actually sending.
# For production, switch to the SMTP backend and set SENDGRID_API_KEY.
# Get a free API key at https://sendgrid.com
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@societytracker.local
